node_modules/
dist/
coverage/
.angular/
.cache/
# .env contiene los secretos reales inyectados en docker-compose.
# Solo .env.example (con valores vacios) se versiona.
.env
.env.local
.env.*.local
!.env.example
*.log
tmp/
reports/*.json
reports/*.md
reports/codebert-changed-files.txt
.cache/huggingface/
__pycache__/
.claude

# Cache de npm. Se habia colado en el repositorio (366 archivos, ~134 MB): era
# el 60% de los ficheros versionados. Es contenido regenerable.
.npm-cache/

# Claves RSA generadas en tiempo de ejecucion por KeysService. NUNCA versionar
# la clave privada: en produccion y K8s se montan desde un Secret.
keys/
*.pem

# Servicios externos — no se versionan en este repositorio
services/

# Secretos y claves de los overlays de Kubernetes (solo se versiona el .example).
k8s/overlays/*/secrets.env
k8s/overlays/*/keys/

# `docs/` NO se ignora: la documentacion (arquitectura, seguridad, ADR,
# auditorias) es parte de la entrega y debe viajar con el repositorio.
