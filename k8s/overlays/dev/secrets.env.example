# Copia a secrets.env (ignorado por git) y rellena con valores propios.
# Genera los secretos operativos con: openssl rand -base64 24
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/master_gateway?schema=public
INTERNAL_API_KEY=
MASTER_INTERNAL_API_KEY=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345!
