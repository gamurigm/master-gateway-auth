# Copia a secrets.env (ignorado por git) y rellena con valores propios.
# Genera cada uno con: openssl rand -base64 24
# JWE_SECRET debe medir EXACTAMENTE 32 bytes.
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/master_gateway?schema=public
JWT_SECRET=
JWE_SECRET=
TEMP_JWT_SECRET=
REFRESH_JWT_SECRET=
INTERNAL_API_KEY=
MASTER_INTERNAL_API_KEY=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345!
