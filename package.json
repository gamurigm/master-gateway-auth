{
    "name": "master-gateway-workspace",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "backend",
        "frontend-vue"
    ],
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
        "npm": ">=8.0.0"
    },
    "scripts": {
        "dev:backend": "npm run start:dev -w backend",
        "dev:frontend": "npm run dev -w frontend-vue",
        "build": "npm run prisma:generate && npm run build:backend && npm run build:frontend",
        "build:backend": "npm run build -w backend",
        "build:frontend": "npm run build -w frontend-vue",
        "configure:frontend": "node scripts/configure-frontend-environment.mjs",
        "start:backend:prod": "npm run prisma:deploy -w backend && node backend/dist/prisma/seed.js && npm run start:prod -w backend",
        "deploy": "node scripts/deploy.js",
        "lint": "npm run lint -w backend && npm run lint -w frontend-vue",
        "test": "npm run test -w backend",
        "test:backend": "npm run test -w backend",
        "test:coverage": "npm run test:cov -w backend -- --runInBand",
        "sonar:scan": "sonar-scanner-npm",
        "sast:selftest": "python security/codebert-sast/selftest.py",
        "sast:rules": "python security/codebert-sast/codebert_sast.py --rules-only",
        "sast:fixtures": "python security/codebert-sast/codebert_sast.py --rules-only --include-fixtures --path security/fixtures/vulnerable --report reports/codebert-fixtures.json --markdown-report reports/codebert-fixtures.md",
        "prisma:validate": "node -e \"process.env.DATABASE_URL ||= 'postgresql://postgres:postgres@localhost:5442/master_gateway?schema=public'; require('node:child_process').execSync('npx prisma validate --schema backend/prisma/schema.prisma', { stdio: 'inherit', env: process.env, shell: true });\"",
        "prisma:generate": "npm run prisma:generate -w backend",
        "prisma:migrate": "npm run prisma:migrate -w backend",
        "prisma:seed": "npm run prisma:seed -w backend",
        "prisma:seed:sql": "node -e \"const{execFileSync}=require('node:child_process');const url=process.env.DATABASE_URL||'postgresql://postgres:postgres@localhost:5442/master_gateway?schema=public';execFileSync('psql',[url,'-v','ON_ERROR_STOP=1','-f','backend/prisma/seeds/seed.sql'],{stdio:'inherit'});\""
    },
    "devDependencies": {
        "@sonar/scan": "^5.0.0"
    }
}
