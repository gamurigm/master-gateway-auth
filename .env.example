# Copia este archivo a .env y rellena los valores. .env esta ignorado por git.
#
#   cp .env.example .env
#
# Genera cada secreto con un valor aleatorio distinto, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# JWE_SECRET debe medir EXACTAMENTE 32 bytes (lo valida backend/src/config/env.validation.ts):
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"

# --- Base de datos ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5442/master_gateway?schema=public"
POSTGRES_PORT=5442
PORT=3000
FRONTEND_ORIGIN="http://localhost:4200"

# --- Claves y tokens ---
JWT_ISSUER="master-gateway"
JWT_AUDIENCE="master-gateway-clients"
JWT_PRIVATE_KEY_PATH="./keys/private.pem"
JWT_PUBLIC_KEY_PATH="./keys/public.pem"
JWT_SECRET=""
JWE_SECRET=""
TEMP_JWT_SECRET=""
REFRESH_JWT_SECRET=""

# --- Zero Trust entre microservicios ---
# El mismo valor debe estar en el Master (INTERNAL_API_KEY) y en cada hijo
# (MASTER_INTERNAL_API_KEY). docker-compose lo propaga automaticamente.
INTERNAL_API_KEY=""
INTERNAL_ALLOWED_SERVICES="ventas"

# --- Seed ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# --- Microservicio de ventas ---
VENTAS_PORT=3006
MASTER_VALIDATE_URL="http://localhost:3000/api/internals/validate-token"
MASTER_INTERNAL_SERVICE_NAME="ventas"
VENTAS_ALLOWED_ROLES="ADMIN,VENTAS"

# --- Registro de microservicios externos ---
# El endpoint /api/external-services/probe bloquea por defecto los destinos en
# rangos privados/loopback (defensa SSRF, CWE-918). En docker-compose y en
# Kubernetes los servicios hijos SI viven en rangos privados, asi que ahi se
# habilita explicitamente. Debe quedar en false en produccion.
ALLOW_PRIVATE_PROBE_TARGETS="false"

# --- Analisis estatico ---
SONAR_HOST_URL="http://localhost:9000"
